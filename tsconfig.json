{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "@medico/types": ["./packages/types/src/index.ts"],
      "@medico/business-logic": ["./packages/business-logic/src/index.ts"],
      "@medico/pdf": ["./packages/pdf/src/index.ts"]
      ,"@medico/api-core": ["./packages/api-core/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts"],
  "exclude": ["node_modules"]
}
