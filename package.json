{
  "name": "medico",
  "private": true,
  "version": "0.1.0",
  "description": "MEDICO - practice management and prescription platform",
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "scripts": {
    "test": "tsx --test \"packages/**/*.test.ts\"",
    "test:db": "tsx --test packages/db-tests/src/*.test.ts",
    "test:pdf": "tsx --test packages/pdf/src/*.test.ts",
    "test:logic": "tsx --test packages/business-logic/src/*.test.ts",
    "test:api": "tsx --test packages/api-core/src/*.test.ts packages/db-tests/src/export.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:cluster:start": "bash scripts/pg-test-cluster.sh start",
    "db:cluster:stop": "bash scripts/pg-test-cluster.sh stop"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  }
}
